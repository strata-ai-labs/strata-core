{
  "$defs": {
    "EventData": {
      "description": "Event record payload and chain facts.",
      "properties": {
        "event_type": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "payload": true,
        "previous_hash": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timestamp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "event_type",
        "payload",
        "timestamp",
        "previous_hash",
        "hash"
      ],
      "type": "object"
    },
    "EventVersionedData": {
      "description": "Event record with commit metadata.",
      "properties": {
        "event": {
          "$ref": "#/$defs/EventData"
        },
        "timestamp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "event",
        "version",
        "timestamp"
      ],
      "type": "object"
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/event.get.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "event.get",
  "request": {
    "additionalProperties": false,
    "description": "Reads one event by sequence.",
    "properties": {
      "as_of": {
        "description": "Optional timestamp in microseconds.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "sequence": {
        "description": "Event sequence.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "event_get",
        "type": "string"
      }
    },
    "required": [
      "type",
      "sequence"
    ],
    "type": "object"
  },
  "response": {
    "description": "Optional event record.",
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/EventVersionedData"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": {
        "const": "event_record",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}
