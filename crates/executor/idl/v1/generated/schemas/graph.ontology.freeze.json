{
  "$defs": {
    "CommitDurability": {
      "description": "Per-commit durability, as storage attested it at acknowledgement time.\n\n`standard` is an admission fact, not a survival guarantee: the commit\nbecomes durable at the next sync point (close, threshold, rotation) and\ncan be lost to process kill until then. Only `always` attests the commit\nwas synced before acknowledgement. `uncertain` means storage could not\nattest either way (#2756: the former `durable` boolean reported\n`standard` commits as durable, so SDK callers treated unsynced\nacknowledgements as crash-safe).",
      "oneOf": [
        {
          "const": "not_durable",
          "description": "Volatile commit (cache mode): gone when the process exits.",
          "type": "string"
        },
        {
          "const": "standard",
          "description": "Durable after the next sync point; lost with the process until then.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Synced to durable storage before acknowledgement.",
          "type": "string"
        },
        {
          "const": "uncertain",
          "description": "Storage could not attest this commit's durability.",
          "type": "string"
        }
      ]
    },
    "CommitReceipt": {
      "description": "Commit facts returned by mutating operations.",
      "properties": {
        "delete_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "durability": {
          "$ref": "#/$defs/CommitDurability"
        },
        "put_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timestamp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "timestamp",
        "durability",
        "put_count",
        "delete_count"
      ],
      "type": "object"
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/graph.ontology.freeze.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "graph.ontology.freeze",
  "request": {
    "additionalProperties": false,
    "description": "Freezes the ontology after validating it; writes then enforce it.",
    "properties": {
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "graph": {
        "description": "Graph name.",
        "type": "string"
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "graph_freeze_ontology",
        "type": "string"
      }
    },
    "required": [
      "type",
      "graph"
    ],
    "type": "object"
  },
  "response": {
    "description": "Graph ontology freeze acknowledgement.",
    "properties": {
      "data": {
        "properties": {
          "commit": {
            "$ref": "#/$defs/CommitReceipt",
            "description": "Commit receipt."
          },
          "graph": {
            "description": "Graph name.",
            "type": "string"
          },
          "link_types": {
            "description": "Frozen link type count.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "object_types": {
            "description": "Frozen object type count.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "graph",
          "object_types",
          "link_types",
          "commit"
        ],
        "type": "object"
      },
      "type": {
        "const": "graph_ontology_freeze_result",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}
