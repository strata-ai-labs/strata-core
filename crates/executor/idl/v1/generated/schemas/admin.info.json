{
  "$defs": {
    "AdminDatabaseInfo": {
      "description": "Database information output.",
      "properties": {
        "branch_count": {
          "description": "Active branch count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "created": {
          "description": "True when this open created a new database.",
          "type": "boolean"
        },
        "default_branch": {
          "description": "Default product branch.",
          "type": "string"
        },
        "durable": {
          "description": "True when storage is durable.",
          "type": "boolean"
        },
        "memory_budget": {
          "$ref": "#/$defs/AdminMemoryBudget",
          "description": "Storage memory budget: its total and where it came from (#2905)."
        },
        "open": {
          "description": "True while the database handle is open.",
          "type": "boolean"
        },
        "space_count": {
          "description": "Registered space count for the selected branch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/AdminOpenTarget",
          "description": "Open target."
        },
        "version": {
          "description": "Engine package version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "target",
        "created",
        "durable",
        "default_branch",
        "branch_count",
        "space_count",
        "memory_budget",
        "open"
      ],
      "type": "object"
    },
    "AdminMemoryBudget": {
      "additionalProperties": false,
      "description": "Storage memory budget provenance and total for `admin.info`.",
      "properties": {
        "source": {
          "$ref": "#/$defs/AdminMemoryBudgetSource",
          "description": "Where the budget came from."
        },
        "total_bytes": {
          "description": "The resolved storage memory budget total, in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "usable_host_bytes": {
          "description": "The usable host memory the derivation started from, in bytes — present\nonly when `source` is `derived_from_host`.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "total_bytes",
        "source"
      ],
      "type": "object"
    },
    "AdminMemoryBudgetSource": {
      "description": "How an opened database's storage memory budget was chosen.",
      "oneOf": [
        {
          "const": "explicit",
          "description": "The caller set a memory budget explicitly.",
          "type": "string"
        },
        {
          "const": "derived_from_host",
          "description": "Derived at open from host memory (25% of usable memory, clamped to `[1 MiB, 8 GiB]`).",
          "type": "string"
        },
        {
          "const": "fixed_default",
          "description": "The fixed built-in default (the host reported no memory facts, or a deterministic open).",
          "type": "string"
        }
      ]
    },
    "AdminOpenTarget": {
      "description": "Database open target exposed in admin outputs.",
      "oneOf": [
        {
          "const": "cache",
          "description": "Volatile cache-backed database.",
          "type": "string"
        },
        {
          "const": "durable_local",
          "description": "Durable local filesystem-backed database.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/admin.info.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "admin.info",
  "request": {
    "additionalProperties": false,
    "description": "Returns database identity and catalog summary.",
    "properties": {
      "branch": {
        "description": "Branch whose space catalog should be summarized. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "info",
        "type": "string"
      }
    },
    "required": [
      "type"
    ],
    "type": "object"
  },
  "response": {
    "description": "Database identity and catalog summary.",
    "properties": {
      "data": {
        "$ref": "#/$defs/AdminDatabaseInfo"
      },
      "type": {
        "const": "database_info",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}
